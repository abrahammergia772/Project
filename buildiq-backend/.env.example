# ---------- App ----------
ENV=development                       # development | staging | production
APP_VERSION=1.0.0

# ---------- Security ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Supabase Postgres ----------
# Supabase → Project Settings → Database → Connection string → URI
# Use the pooled connection (port 6543) for serverless/edge deployments.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------- Supabase Storage (document uploads) ----------
# Settings → API. The service_role key is server-side only — never ship it to a browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_BUCKET=buildiq-documents
MAX_UPLOAD_MB=25

# ---------- Groq (AI) ----------
# https://console.groq.com/keys — leave blank to run on local heuristics only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_ENABLED=true

# ---------- CORS ----------
# Comma-separated origins. Use "*" only in development.
CORS_ORIGINS=http://localhost:8080,https://your-frontend.onrender.com

# ---------- Seeding ----------
SEED_ON_STARTUP=true
SEED_DEMO_PASSWORD=Demo1234!
